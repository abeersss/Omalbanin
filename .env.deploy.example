# Copy this file to .env.deploy and fill in the real values.
# .env.deploy is gitignored. Never commit it and never paste these into chat.
#
# Get these from hPanel: Files > FTP Accounts. Hostinger will not show you an
# existing password, it only lets you set a new one.

FTP_HOST=ftp.omalbnin.com
FTP_USER=
FTP_PASSWORD=

# The domain's document root. Usually /public_html. For an addon domain it may
# be /domains/omalbnin.com/public_html. The right folder is the one that
# currently contains wp-config.php.
FTP_REMOTE_DIR=/public_html
